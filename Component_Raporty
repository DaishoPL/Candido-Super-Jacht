  function exportToPDF() {
    if (!currentReportData) return;
    if (typeof html2pdf === 'undefined') {
      alert("Trwa ładowanie biblioteki PDF. Spróbuj ponownie za chwilę.");
      return;
    }
    window.scrollTo(0, 0);
    setTimeout(() => {
      const element = document.getElementById('reportContent');
      const isWeekly = currentReportType === 'weekly';
      let pdfStyles = '';
      
      // Przełamywanie stron i unikanie podziałów tabel jest teraz aktywne w obu wersjach
      if (!isWeekly) {
        pdfStyles = `<style id="pdf-styles"> .report-page { page-break-after: always; page-break-inside: avoid; } .report-page:last-child { page-break-after: auto; } .report-page table { font-size: 8px !important; } .report-page th, .report-page td { padding: 1px 2px !important; } </style>`;
      } else {
        pdfStyles = `<style id="pdf-styles"> .report-page { page-break-after: always; page-break-inside: avoid; } .report-page:last-child { page-break-after: auto; } </style>`;
      }
      
      document.head.insertAdjacentHTML('beforeend', pdfStyles);
      const weekNum = isWeekly ? currentReportData.weekInfo.weekNumber : 'Annual';
      const opt = { margin: 0.3, filename: `Candido_Report_${weekNum}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas:  { scale: 2, useCORS: true }, jsPDF: { unit: 'in', format: 'a4', orientation: isWeekly ? 'portrait' : 'landscape' } };
      
      html2pdf().set(opt).from(element).save().then(() => {
        const styleTag = document.getElementById('pdf-styles');
        if (styleTag) styleTag.remove();
      });
    }, 0);
  }

  // --- FUNKCJA: EKSPORT DO EXCEL PRZEZ BACKEND ---
  function exportToExcel() {
    if (!currentReportData) {
      alert("Najpierw wygeneruj raport.");
      return;
    }
    const btn = document.getElementById('btnExportExcel');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Generowanie...';
    btn.disabled = true;
    google.script.run
      .withSuccessHandler(response => {
        if (response && response.fileUrl) {
          window.open(response.fileUrl, '_blank');
        } else {
          alert("Wystąpił błąd po stronie serwera, ale nie otrzymano linku do pliku.");
        }
        btn.innerHTML = '<i class="fa-solid fa-file-excel mr-2"></i> Pobierz XLSX';
        btn.disabled = false;
      })
      .withFailureHandler(err => {
        alert("Błąd generowania pliku: " + err.message);
        btn.innerHTML = '<i class="fa-solid fa-file-excel mr-2"></i> Pobierz XLSX';
        btn.disabled = false;
      })
      .generateStyledExcelReport(currentReportData, currentReportType);
  }
