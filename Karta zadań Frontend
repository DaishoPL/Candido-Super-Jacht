<!DOCTYPE html>
<html lang="pl">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seavia - Panel Brygadzisty</title>
  
  <!-- Tailwind CSS z CDN dla nowoczesnego wyglądu -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome dla ikon -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* Customowe stylowanie w razie potrzeby */
    .loader {
      border: 4px solid #f3f3f3;
      border-top: 4px solid #3b82f6;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans">

  <!-- Pasek nawigacji -->
  <nav class="bg-blue-800 text-white p-4 shadow-md flex justify-between items-center">
    <div class="text-xl font-bold flex items-center">
      <i class="fa-solid fa-ship mr-3"></i> SEAVIA 
    </div>
    <div class="text-sm font-medium opacity-80">
      Panel Brygadzisty
    </div>
  </nav>

  <div class="max-w-4xl mx-auto mt-6 p-4">
    
    <!-- Ekran ładowania -->
    <div id="loadingScreen" class="flex flex-col items-center justify-center py-20">
      <div class="loader mb-4"></div>
      <p class="text-slate-500 font-medium text-lg animate-pulse">Pobieranie bazy zadań i ekipy...</p>
    </div>

    <!-- Główna zawartość -->
    <div id="mainContent" class="hidden">
      
      <!-- Taby (Zakładki) -->
      <div class="flex border-b border-slate-300 mb-6">
        <button id="tabReportBtn" class="py-2 px-4 text-blue-700 border-b-2 border-blue-700 font-medium hover:bg-slate-200 transition-colors" onclick="switchTab('report')">
          <i class="fa-solid fa-clipboard-list mr-2"></i> Raporty & Info
        </button>
        <button id="tabFormBtn" class="py-2 px-4 text-slate-500 font-medium hover:bg-slate-200 transition-colors" onclick="switchTab('form')">
          <i class="fa-solid fa-user-helmet-safety mr-2"></i> Karta Zadań
        </button>
      </div>

      <!-- BLOK 1: Raportowy / Informacyjny -->
      <div id="tabReport" class="block">
        <div class="bg-white rounded-lg shadow-sm p-6 border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-800 mb-4">Dzisiejsze podsumowanie</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="bg-blue-50 rounded p-4 border border-blue-100">
              <p class="text-sm text-blue-500 font-bold uppercase">Data</p>
              <p class="text-2xl font-bold text-blue-900" id="infoDate">...</p>
            </div>
            <div class="bg-emerald-50 rounded p-4 border border-emerald-100">
              <p class="text-sm text-emerald-500 font-bold uppercase">Zadań przypisanych dla Seavia</p>
              <p class="text-2xl font-bold text-emerald-900" id="infoTaskCount">0</p>
            </div>
          </div>
          
          <p class="text-slate-600">
            Przejdź do zakładki <strong>"Karta Zadań"</strong>, aby przypisać pracownika do obszaru, zanotować jego godziny oraz zaktualizować % postępu w arkuszu głównym (Candido).
          </p>
        </div>
      </div>

      <!-- BLOK 2: Panel Brygadzisty (Formularz) -->
      <div id="tabForm" class="hidden">
        <form id="workForm" onsubmit="submitForm(event)" class="bg-white rounded-lg shadow-sm p-6 border border-slate-200">
          
          <div class="mb-6 pb-4 border-b border-slate-100">
            <div class="flex justify-between items-center mb-3">
              <h3 class="text-lg font-bold text-slate-700"><i class="fa-regular fa-clock mr-2 text-blue-600"></i> Kto i Kiedy</h3>
              
              <!-- Przycisk dodawania nowego technika -->
              <button type="button" onclick="promptAddTechnician()" class="text-sm bg-slate-100 hover:bg-slate-200 text-blue-700 font-medium py-1 px-3 rounded border border-slate-300 transition-colors">
                <i class="fa-solid fa-plus mr-1"></i> Dodaj osobę
              </button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- Wybór Technika -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Wybierz pracownika</label>
                <select id="technician" required onchange="onTechOrDateChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white">
                  <option value="" disabled selected>Wybierz technika z listy...</option>
                </select>
              </div>

              <!-- Wybór Daty -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Data prac</label>
                <input type="date" id="workDate" required onchange="onTechOrDateChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-blue-500 bg-white">
              </div>

              <!-- Czas Start -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Godzina rozpoczęcia</label>
                <input type="time" id="timeStart" required onchange="validateTimes()" oninput="validateTimes()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-blue-500 bg-white">
              </div>

              <!-- Czas Stop -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Godzina zakończenia</label>
                <input type="time" id="timeEnd" required onchange="validateTimes()" oninput="validateTimes()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-blue-500 bg-white">
              </div>

              <!-- Komunikat Błędu Czasu (Pojawia się automatycznie) -->
              <div id="timeErrorMsg" class="col-span-1 md:col-span-2 hidden">
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded relative" role="alert">
                  <span class="block sm:inline" id="timeErrorText"><i class="fa-solid fa-circle-exclamation mr-1"></i> Błąd: ...</span>
                </div>
              </div>

              <!-- NOWOŚĆ: Wyświetlanie aktualnego harmonogramu -->
              <div id="scheduleSection" class="col-span-1 md:col-span-2 hidden mt-2">
                 <div class="p-3 bg-indigo-50 border border-indigo-200 rounded-md">
                   <h4 class="text-sm font-bold text-indigo-800 mb-2"><i class="fa-solid fa-list-check mr-1"></i> Zaplanowane prace na ten dzień:</h4>
                   <ul id="scheduleList" class="text-sm text-indigo-900 space-y-1">
                      <!-- Lista pobrana z bazy -->
                   </ul>
                 </div>
              </div>
            </div>
          </div>

          <div class="mb-6 pb-4 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-700 mb-3"><i class="fa-solid fa-hammer mr-2 text-blue-600"></i> Przydział Zadania (Candido)</h3>
            
            <div class="space-y-4">
              <!-- Krok 1: DECK -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">1. Wybierz Pokład (Deck)</label>
                <select id="deckSelect" required onchange="onDeckChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-blue-500 bg-white">
                  <option value="" disabled selected>Najpierw wybierz pokład...</option>
                </select>
              </div>

              <!-- Krok 2: OBSZAR -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">2. Wybierz Powierzchnię / Obszar</label>
                <select id="areaSelect" required onchange="onAreaChange()" disabled class="w-full rounded-md border border-slate-300 p-2.5 bg-slate-50 opacity-70">
                  <option value="" disabled selected>Wybierz powierzchnię...</option>
                </select>
              </div>

              <!-- Krok 3: ZADANIE -->
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">3. Wykonane Zadanie</label>
                <select id="taskSelect" required onchange="onTaskChange()" disabled class="w-full rounded-md border border-slate-300 p-2.5 bg-slate-50 opacity-70">
                  <option value="" disabled selected>Wybierz zadanie...</option>
                </select>
                <!-- Ukryte pole trzymające numer wiersza w pliku Candido -->
                <input type="hidden" id="taskRowNumber">
              </div>
            </div>
          </div>

          <!-- POSTĘP -->
          <div id="progressSection" class="mb-8 hidden transition-all duration-300">
            <div class="bg-blue-50 rounded-lg p-5 border border-blue-100">
              <h3 class="text-lg font-bold text-blue-800 mb-2"><i class="fa-solid fa-chart-pie mr-2"></i> Poziom wykonania zadania</h3>
              <p class="text-sm text-slate-600 mb-4">Określ szacunkowy postęp procentowy dla wybranego zadania. Wartość zostanie zapisana w głównym arkuszu w kolumnie P.</p>
              
              <div class="flex items-center gap-4">
                <input type="range" id="progressRange" min="0" max="100" step="5" value="0" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer" oninput="document.getElementById('progressValue').innerText = this.value + '%'">
                <span id="progressValue" class="text-xl font-bold text-blue-700 min-w-[3rem]">0%</span>
              </div>
            </div>
          </div>

          <!-- Przycisk Zapisu -->
          <button type="submit" id="submitBtn" class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-md shadow-md transition-all flex justify-center items-center">
            <span>Zapisz pracę w systemie</span>
            <i class="fa-solid fa-paper-plane ml-2"></i>
          </button>
          
        </form>
      </div>

    </div>

  </div>

  <!-- Skrypty obsługujące zachowanie na stronie -->
  <script>
    // Zmienna przechowująca pobrane dane (drzewko zadań)
    let appData = null;
    // Zmienna przechowująca aktualne zadania technika na dany dzień
    let currentTechSchedule = [];

    // Funkcja odpalana zaraz po załadowaniu HTML
    window.onload = function() {
      // Ustawienie domyślnej daty na dzisiaj
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('workDate').value = today;
      document.getElementById('infoDate').innerText = new Date().toLocaleDateString('pl-PL');

      // Wywołanie backendu z Apps Script, aby pobrał dane
      google.script.run
        .withSuccessHandler(onDataLoaded)
        .withFailureHandler(function(err) {
          alert("Błąd podczas pobierania danych z Arkusza: " + err);
        })
        .getInitialData();
    };

    // Callback po udanym pobraniu danych z Arkusza
    function onDataLoaded(data) {
      appData = data;
      
      // 1. Zapełnij listę techników
      const techSelect = document.getElementById('technician');
      techSelect.innerHTML = '<option value="" disabled selected>Wybierz technika z listy...</option>'; // Czyszczenie
      data.technicians.forEach(tech => {
        let opt = document.createElement('option');
        opt.value = tech; opt.innerText = tech;
        techSelect.appendChild(opt);
      });

      // 2. Zapełnij listę Pokładów (Deck) z drzewa zadań
      const deckSelect = document.getElementById('deckSelect');
      let totalTasks = 0;
      
      deckSelect.innerHTML = '<option value="" disabled selected>Najpierw wybierz pokład...</option>'; // Czyszczenie
      Object.keys(data.tasksTree).sort().forEach(deck => {
        let opt = document.createElement('option');
        opt.value = deck; opt.innerText = deck;
        deckSelect.appendChild(opt);
        
        // Zliczanie zadań dla statystyk
        Object.keys(data.tasksTree[deck]).forEach(area => {
          totalTasks += data.tasksTree[deck][area].length;
        });
      });

      // Aktualizacja statystyk
      document.getElementById('infoTaskCount').innerText = totalTasks;

      // Ukryj loading, pokaż aplikację
      document.getElementById('loadingScreen').classList.add('hidden');
      document.getElementById('mainContent').classList.remove('hidden');
    }

    // Dodawanie nowego pracownika
    function promptAddTechnician() {
      const name = prompt("Podaj imię i nazwisko nowego pracownika:");
      if (name && name.trim() !== "") {
        // Pokaż, że ładuje
        document.getElementById('loadingScreen').classList.remove('hidden');
        document.getElementById('mainContent').classList.add('hidden');
        
        // Wywołaj backend
        google.script.run
          .withSuccessHandler(function(response) {
            if(response.success) {
              alert(response.message);
              // Ponownie pobierz dane z arkusza, by odświeżyć listę
              google.script.run.withSuccessHandler(onDataLoaded).getInitialData();
            } else {
              alert("Błąd: " + response.message);
              document.getElementById('loadingScreen').classList.add('hidden');
              document.getElementById('mainContent').classList.remove('hidden');
            }
          })
          .addTechnician(name);
      }
    }

    // Pobieranie harmonogramu po zmianie technika lub daty
    function onTechOrDateChange() {
      const tech = document.getElementById('technician').value;
      const date = document.getElementById('workDate').value;
      const scheduleSection = document.getElementById('scheduleSection');
      const scheduleList = document.getElementById('scheduleList');

      // Za każdym razem po zmianie daty lub technika czyścimy błędy, by dać szansę na poprawny wpis
      resetTimeErrors();

      if (tech && date) {
        // Pokazujemy że trwa pobieranie
        scheduleList.innerHTML = '<li class="text-slate-500 italic"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Sprawdzanie harmonogramu...</li>';
        scheduleSection.classList.remove('hidden');

        // Wysyłamy prośbę do backendu
        google.script.run
          .withSuccessHandler(function(tasks) {
            currentTechSchedule = tasks;
            if (tasks.length === 0) {
              scheduleList.innerHTML = '<li class="text-emerald-600 font-medium"><i class="fa-solid fa-check mr-1"></i> Brak przypisanych prac. Technik jest wolny.</li>';
            } else {
              // Mapowanie odebranych prac na listę HTML
              scheduleList.innerHTML = tasks.map(t => 
                `<li><strong>${t.start} - ${t.end}</strong> | ${t.deck} | ${t.taskName}</li>`
              ).join('');
            }
            
            // Re-walidacja na wypadek gdyby użytkownik już wpisał godziny, a dopiero teraz wybrał technika
            validateTimes();
          })
          .withFailureHandler(function(err) {
            scheduleList.innerHTML = `<li class="text-red-500"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Błąd pobierania danych: ${err}</li>`;
          })
          .getTechnicianTasksForDate(tech, date);
      } else {
        // Chowamy sekcję, jeśli nie podano obu parametrów
        scheduleSection.classList.add('hidden');
        currentTechSchedule = [];
      }
    }

    // -------- WALIDACJA W CZASIE RZECZYWISTYM (REAL-TIME) --------
    function validateTimes() {
      const timeStart = document.getElementById('timeStart').value;
      const timeEnd = document.getElementById('timeEnd').value;
      
      resetTimeErrors(); // Resetujemy błędy na początku walidacji

      // Sprawdzamy dopiero, gdy wpisano oba czasy
      if (!timeStart || !timeEnd) return;

      // 1. Walidacja poprawnej kolejności
      if (timeStart >= timeEnd) {
        showTimeError('Godzina zakończenia musi być późniejsza niż godzina rozpoczęcia!');
        return; // Zatrzymujemy się na tym błędzie
      }

      // 2. Walidacja konfliktów z harmonogramem
      let conflictTask = null;
      for (let task of currentTechSchedule) {
        // Logika pozwala na ciągłość!
        // Przykład: jeśli jest wpis 7:00-11:00, wpisanie 11:00-13:00 jest DOZWOLONE
        // Konflikt występuje TYLKO, gdy NowyStart jest ostro przed StarymKońcem 
        // I JEDNOCZEŚNIE NowyKoniec jest ostro po StarymStarcie.
        if (timeStart < task.end && timeEnd > task.start) {
          conflictTask = task;
          break;
        }
      }

      if (conflictTask) {
        showTimeError(`Konflikt z harmonogramem! Wybrane godziny wchodzą na zadanie: <strong>${conflictTask.start} - ${conflictTask.end}</strong> (${conflictTask.deck}).`);
      }
    }

    function showTimeError(message) {
      const errorMsgContainer = document.getElementById('timeErrorMsg');
      const errorText = document.getElementById('timeErrorText');
      const submitBtn = document.getElementById('submitBtn');

      errorText.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-1"></i> ${message}`;
      errorMsgContainer.classList.remove('hidden');
      
      // Zablokuj przycisk Zapisz i zmień jego wygląd, by wizualnie pokazać, że jest nieaktywny
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      submitBtn.classList.remove('hover:bg-blue-800');
    }

    function resetTimeErrors() {
      const errorMsgContainer = document.getElementById('timeErrorMsg');
      const submitBtn = document.getElementById('submitBtn');

      errorMsgContainer.classList.add('hidden');
      
      // Odblokuj przycisk Zapisz
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      submitBtn.classList.add('hover:bg-blue-800');
    }

    // Obsługa przełączania zakładek
    function switchTab(tabId) {
      document.getElementById('tabReport').classList.add('hidden');
      document.getElementById('tabForm').classList.add('hidden');
      
      document.getElementById('tabReportBtn').classList.remove('text-blue-700', 'border-blue-700', 'border-b-2');
      document.getElementById('tabFormBtn').classList.remove('text-blue-700', 'border-blue-700', 'border-b-2');
      
      if(tabId === 'report') {
        document.getElementById('tabReport').classList.remove('hidden');
        document.getElementById('tabReportBtn').classList.add('text-blue-700', 'border-blue-700', 'border-b-2');
      } else {
        document.getElementById('tabForm').classList.remove('hidden');
        document.getElementById('tabFormBtn').classList.add('text-blue-700', 'border-blue-700', 'border-b-2');
      }
    }

    // -------- LOGIKA LIST KASKADOWYCH --------

    // Krok 1: Wybrano Deck
    function onDeckChange() {
      const selectedDeck = document.getElementById('deckSelect').value;
      const areaSelect = document.getElementById('areaSelect');
      const taskSelect = document.getElementById('taskSelect');
      
      // Reset obszaru i zadań
      areaSelect.innerHTML = '<option value="" disabled selected>Wybierz powierzchnię...</option>';
      taskSelect.innerHTML = '<option value="" disabled selected>Wybierz zadanie...</option>';
      taskSelect.disabled = true; taskSelect.classList.add('bg-slate-50', 'opacity-70');
      document.getElementById('progressSection').classList.add('hidden');

      if (selectedDeck && appData.tasksTree[selectedDeck]) {
        // Wypełnianie powierzchni dostępnych dla danego pokładu
        Object.keys(appData.tasksTree[selectedDeck]).sort().forEach(area => {
          let opt = document.createElement('option');
          opt.value = area; opt.innerText = area;
          areaSelect.appendChild(opt);
        });
        
        areaSelect.disabled = false;
        areaSelect.classList.remove('bg-slate-50', 'opacity-70');
      }
    }

    // Krok 2: Wybrano Obszar
    function onAreaChange() {
      const selectedDeck = document.getElementById('deckSelect').value;
      const selectedArea = document.getElementById('areaSelect').value;
      const taskSelect = document.getElementById('taskSelect');
      
      taskSelect.innerHTML = '<option value="" disabled selected>Wybierz zadanie...</option>';
      document.getElementById('progressSection').classList.add('hidden');

      if (selectedDeck && selectedArea && appData.tasksTree[selectedDeck][selectedArea]) {
        // Wypełnianie zadań dla danego Decku i Obszaru
        appData.tasksTree[selectedDeck][selectedArea].forEach(taskObj => {
          let opt = document.createElement('option');
          opt.value = taskObj.taskName; 
          opt.innerText = taskObj.taskName;
          opt.dataset.row = taskObj.row; // Przechowujemy nr wiersza
          opt.dataset.progress = taskObj.progress; // NOWOŚĆ: Przechowujemy obecny postęp pobrany z bazy
          taskSelect.appendChild(opt);
        });
        
        taskSelect.disabled = false;
        taskSelect.classList.remove('bg-slate-50', 'opacity-70');
      }
    }

    // Krok 3: Wybrano Zadanie
    function onTaskChange() {
      const taskSelect = document.getElementById('taskSelect');
      const rowInput = document.getElementById('taskRowNumber');
      const progressSection = document.getElementById('progressSection');
      const progressRange = document.getElementById('progressRange');
      const progressValue = document.getElementById('progressValue');
      
      // Zapisujemy numer wiersza, by backend wiedział, gdzie wpisać procenty
      const selectedOption = taskSelect.options[taskSelect.selectedIndex];
      rowInput.value = selectedOption.dataset.row;
      
      // NOWOŚĆ: Odczytujemy aktualny postęp z arkusza i ustawiamy suwak
      const currentProgress = selectedOption.dataset.progress || 0;
      progressRange.value = currentProgress;
      progressValue.innerText = currentProgress + '%';
      
      // Pokazujemy suwak procentów
      progressSection.classList.remove('hidden');
    }

    // -------- WYSYŁANIE FORMULARZA --------
    function submitForm(event) {
      event.preventDefault(); // Zatrzymuje przeładowanie strony
      
      // Ponowna walidacja upewniająca przed samym zapisem (w ramach bezpieczeństwa)
      const timeStart = document.getElementById('timeStart').value;
      const timeEnd = document.getElementById('timeEnd').value;

      if (timeStart >= timeEnd) {
        showTimeError('Godzina zakończenia musi być późniejsza niż godzina rozpoczęcia!');
        return;
      }

      let hasOverlap = false;
      for (let task of currentTechSchedule) {
        if (timeStart < task.end && timeEnd > task.start) {
          hasOverlap = true;
          break;
        }
      }

      if (hasOverlap) {
        alert("Błąd krytyczny: Harmonogram nie uległ odświeżeniu, a godziny się nakładają!");
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Zapisywanie...';
      btn.disabled = true;

      // Budowanie obiektu z danymi
      const formData = {
        technician: document.getElementById('technician').value,
        workDate: document.getElementById('workDate').value,
        timeStart: timeStart,
        timeEnd: timeEnd,
        deck: document.getElementById('deckSelect').value,
        area: document.getElementById('areaSelect').value,
        taskName: document.getElementById('taskSelect').value,
        taskRow: document.getElementById('taskRowNumber').value,
        progress: document.getElementById('progressRange').value
      };

      // Wysłanie do backendu
      google.script.run
        .withSuccessHandler(function(response) {
          if (response.success) {
            alert(response.message);
            // Odśwież harmonogram po poprawnym zapisie
            onTechOrDateChange();
            // Resetuj formularz ale zostaw datę i technika (wygoda przy wpisywaniu wielu zadań pod rząd)
            document.getElementById('deckSelect').value = "";
            document.getElementById('timeStart').value = ""; // Czyścimy pola godzinowe po dodaniu zadania
            document.getElementById('timeEnd').value = "";
            onDeckChange(); // resetuje niższe pola
          } else {
            alert("Błąd: " + response.message);
          }
          btn.innerHTML = '<span>Zapisz pracę w systemie</span><i class="fa-solid fa-paper-plane ml-2"></i>';
          btn.disabled = false;
        })
        .withFailureHandler(function(err) {
          alert("Krytyczny błąd połączenia: " + err);
          btn.innerHTML = '<span>Zapisz pracę w systemie</span><i class="fa-solid fa-paper-plane ml-2"></i>';
          btn.disabled = false;
        })
        .submitWorkReport(formData);
    }
  </script>
