<div class="bg-white rounded-lg shadow-sm p-8 border border-gray-100 animate-fade-in">
  <h2 class="text-2xl font-bold text-seaviaBlue mb-6 border-b pb-2">Karta Zadań</h2>

  <form id="workReportForm" onsubmit="submitForm(event)">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- LEWA STRONA: KTO I KIEDY -->
      <div class="space-y-6">
        
        <!-- Przełącznik Trybu Przypisywania -->
        <div class="bg-slate-50 p-4 rounded-md border border-slate-200">
          <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-3">Tryb przypisywania</p>
          <div class="flex space-x-6">
            <label class="flex items-center space-x-2 cursor-pointer group">
              <input type="radio" name="assignMode" value="tech" checked class="w-4 h-4 text-seaviaBlue focus:ring-seaviaBlue" onchange="switchAssignMode()">
              <span class="text-sm font-bold text-slate-700 group-hover:text-seaviaBlue transition-colors">Pojedynczy Technik</span>
            </label>
            <label class="flex items-center space-x-2 cursor-pointer group">
              <input type="radio" name="assignMode" value="team" class="w-4 h-4 text-seaviaBlue focus:ring-seaviaBlue" onchange="switchAssignMode()">
              <span class="text-sm font-bold text-slate-700 group-hover:text-seaviaBlue transition-colors">Cały Team</span>
            </label>
          </div>
        </div>

        <div>
          <label id="assignTargetLabel" class="block text-sm font-bold text-slate-700 mb-1">Wybierz technika</label>
          <select id="assignTarget" class="w-full border border-slate-300 rounded-md p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-slate-50 transition-all" onchange="onTargetOrDateChange()" required>
            <option value="" disabled selected>Ładowanie...</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">Data prac</label>
          <input type="date" id="workDate" class="w-full border border-slate-300 rounded-md p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-slate-50" onchange="onTargetOrDateChange()" required>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Od godziny</label>
            <input type="time" id="timeStart" class="w-full border border-slate-300 rounded-md p-2.5 focus:ring-2 focus:ring-seaviaBlue" onchange="validateTimes()" required>
          </div>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Do godziny</label>
            <input type="time" id="timeEnd" class="w-full border border-slate-300 rounded-md p-2.5 focus:ring-2 focus:ring-seaviaBlue" onchange="validateTimes()" required>
          </div>
        </div>

        <!-- Błędy w czasie -->
        <div id="timeErrorMsg" class="hidden bg-red-50 text-red-600 p-3 rounded-md border border-red-200 text-sm font-bold animate-fade-in shadow-sm">
          <span id="timeErrorText">Konflikt godzin!</span>
        </div>

        <!-- Harmonogram -->
        <div id="scheduleSection" class="hidden mt-4 bg-slate-50 p-4 rounded-md border border-slate-200 shadow-inner">
          <p id="scheduleTitle" class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2">Dzisiejszy harmonogram</p>
          <ul id="scheduleList" class="text-sm space-y-1">
            <!-- Lista zadań wygenerowana przez JS -->
          </ul>
        </div>
      </div>

      <!-- PRAWA STRONA: CO ROBIŁ -->
      <div class="space-y-6">
        
        <!-- Pusty blok wyrównujący do wysokości przełącznika (widoczny tylko na dużych ekranach) -->
        <div class="hidden md:block h-[86px]"></div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">Pokład</label>
          <select id="deckSelect" class="w-full border border-slate-300 rounded-md p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-slate-50" onchange="onDeckChange()" required>
            <option value="" disabled selected>Ładowanie...</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">Powierzchnia / Strefa</label>
          <select id="areaSelect" class="w-full border border-slate-300 rounded-md p-2.5 bg-gray-100 opacity-60 transition-all" disabled onchange="onAreaChange()" required>
            <option value="" disabled selected>Najpierw wybierz pokład...</option>
          </select>
          <input type="text" id="customAreaInput" placeholder="Wpisz nazwę strefy..." class="hidden mt-2 w-full border border-slate-300 rounded-md p-2 focus:ring-2 focus:ring-seaviaBlue">
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1">Zadanie</label>
          <select id="taskSelect" class="w-full border border-slate-300 rounded-md p-2.5 bg-gray-100 opacity-60 transition-all" disabled onchange="onTaskChange()" required>
            <option value="" disabled selected>Najpierw wybierz strefę...</option>
          </select>
          <input type="text" id="customTaskInput" placeholder="Wpisz nazwę zadania..." class="hidden mt-2 w-full border border-slate-300 rounded-md p-2 focus:ring-2 focus:ring-seaviaBlue">
        </div>

        <div id="progressSection" class="hidden bg-blue-50 p-4 rounded-md border border-blue-100 mt-4 animate-fade-in shadow-sm">
          <label class="block text-sm font-bold text-seaviaBlue mb-2">Zaktualizuj % wykonania zadania:</label>
          <div class="flex items-center space-x-4">
            <input type="range" id="progressRange" min="0" max="100" step="5" class="w-full h-2 bg-blue-200 rounded-lg appearance-none cursor-pointer accent-seaviaBlue" oninput="document.getElementById('progressValue').innerText = this.value + '%'">
            <span id="progressValue" class="text-xl font-bold text-seaviaBlue w-16 text-right">0%</span>
          </div>
          <input type="hidden" id="taskRowNumber">
        </div>
      </div>
    </div>

    <!-- Przycisk Zapisu -->
    <div class="mt-10 border-t border-slate-200 pt-6 flex justify-end">
      <button type="submit" id="submitBtn" class="bg-seaviaBlue hover:bg-[#0a1e38] text-white font-bold py-3 px-8 rounded-md shadow-md transition-all flex items-center text-lg">
        <span>Zapisz i prześlij</span>
        <i class="fa-solid fa-paper-plane ml-3"></i>
      </button>
    </div>
  </form>
</div>