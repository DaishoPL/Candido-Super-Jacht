<!DOCTYPE html>
<html lang="pl">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seavia - Panel Brygadzisty</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Konfiguracja kolorów (Candido & Seavia) -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            candidoRed: '#e53e3e',
            seaviaBlue: '#0f2d52',
            bgLight: '#f8fafc'
          }
        }
      }
    }
  </script>

  <style>
    body { background-color: #f8fafc; }
    .loader {
      border: 4px solid #f3f3f3;
      border-top: 4px solid #e53e3e;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body class="text-slate-800 font-sans antialiased">

  <!-- ======================================================= -->
  <!-- KOMPONENT: PASEK NAWIGACJI (HEADER)                     -->
  <!-- ======================================================= -->
  <nav class="bg-white px-6 py-4 flex justify-between items-center shadow-sm border-b border-gray-200 sticky top-0 z-50">
    <!-- Lewa strona: Logo Candido -->
    <div class="flex items-center">
      <img src="https://drive.google.com/thumbnail?id=1lxSTmQcvgVlUts-T_ARGJM63CFPRk7SX&sz=w400" alt="Candido Hermida" class="h-8" onerror="this.onerror=null; this.src='https://via.placeholder.com/150x40?text=CANDIDO+HERMIDA';">
    </div>
    
    <!-- Środek: Tytuł -->
    <div class="text-center hidden md:block">
      <h1 class="text-xl font-bold text-gray-800">NL <span class="text-candidoRed">Time Sheet</span> Candido</h1>
      <p class="text-[10px] text-gray-500 font-bold tracking-widest uppercase mt-0.5">Panel Brygadzisty Projektu</p>
    </div>
    
    <!-- Prawa strona: Przyciski i Logo Seavia -->
    <div class="flex items-center space-x-4">
      <button onclick="refreshData()" class="flex items-center text-candidoRed border border-red-200 bg-red-50 hover:bg-red-100 px-4 py-2 rounded-md text-sm font-bold transition-colors">
        <i class="fa-solid fa-arrows-rotate mr-2"></i> Odśwież dane
      </button>
      
      <!-- Używamy punktu końcowego miniatur do wczytania logo Seavia -->
      <img src="https://drive.google.com/thumbnail?id=1L4VgENQplibUvoIXim4tpkwvIj_UgTLO&sz=w400" alt="Seavia" class="h-8 object-contain" onerror="this.onerror=null; this.src='https://via.placeholder.com/100x40?text=SEAVIA';">
    </div>
  </nav>

  <main class="max-w-4xl mx-auto mt-8 px-4 pb-12">
    
    <!-- Ekran ładowania -->
    <div id="loadingScreen" class="flex flex-col items-center justify-center py-32">
      <div class="loader mb-4"></div>
      <p class="text-slate-500 font-medium text-lg animate-pulse">Pobieranie bazy zadań i ekipy...</p>
    </div>

    <!-- Główna zawartość -->
    <div id="mainContent" class="hidden">

      <!-- ======================================================= -->
      <!-- KOMPONENT: NAWIGACJA ZAKŁADEK (TABS)                    -->
      <!-- ======================================================= -->
      <!-- Zastosowano overflow-x-auto, by na małych ekranach przyciski się przewijały -->
      <div class="flex border-b border-slate-300 mb-6 space-x-1 overflow-x-auto">
        <button id="btn-project" class="py-2 px-5 text-seaviaBlue border-b-2 border-seaviaBlue font-bold bg-white rounded-t-md shadow-sm transition-colors whitespace-nowrap" onclick="switchTab('project')">
          <i class="fa-solid fa-ship mr-2"></i> Realizacja Projektu
        </button>
        <button id="btn-tech" class="py-2 px-5 text-slate-500 font-medium hover:bg-slate-100 rounded-t-md transition-colors whitespace-nowrap" onclick="switchTab('tech')">
          <i class="fa-solid fa-users mr-2"></i> Technicy
        </button>
        <button id="btn-tasks" class="py-2 px-5 text-slate-500 font-medium hover:bg-slate-100 rounded-t-md transition-colors whitespace-nowrap" onclick="switchTab('tasks')">
          <i class="fa-solid fa-user-helmet-safety mr-2"></i> Karta Zadań
        </button>
        <button id="btn-reports" class="py-2 px-5 text-slate-500 font-medium hover:bg-slate-100 rounded-t-md transition-colors whitespace-nowrap" onclick="switchTab('reports')">
          <i class="fa-solid fa-chart-line mr-2"></i> Raporty
        </button>
      </div>

      <!-- ======================================================= -->
      <!-- SEKCJA 1: REALIZACJA PROJEKTU (Wcześniej "Raport")      -->
      <!-- ======================================================= -->
      <div id="sec-project" class="block animate-fade-in">
        <div class="bg-white rounded-lg shadow-sm p-8 border border-gray-100">
          <h2 class="text-2xl font-bold text-seaviaBlue mb-6 border-b pb-2">Status Projektu</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div class="bg-slate-50 rounded-md p-5 border border-slate-200 shadow-sm flex items-center">
              <div class="bg-blue-100 p-3 rounded-full text-blue-600 mr-4">
                <i class="fa-regular fa-calendar fa-lg"></i>
              </div>
              <div>
                <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Dzisiejsza Data</p>
                <p class="text-xl font-bold text-slate-800" id="infoDate">...</p>
              </div>
            </div>
            
            <div class="bg-slate-50 rounded-md p-5 border border-slate-200 shadow-sm flex items-center">
              <div class="bg-red-100 p-3 rounded-full text-candidoRed mr-4">
                <i class="fa-solid fa-list-check fa-lg"></i>
              </div>
              <div>
                <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Zadań w bazie</p>
                <p class="text-xl font-bold text-slate-800" id="infoTaskCount">0</p>
              </div>
            </div>
          </div>
          
          <div class="bg-blue-50 border-l-4 border-seaviaBlue p-4 rounded-r-md">
            <p class="text-sm text-slate-700">
              Przejdź do zakładki <strong>"Karta Zadań"</strong>, aby przypisać pracowników do konkretnych pokładów i zadań z harmonogramu głównego Candido. Aplikacja automatycznie zaktualizuje arkusze z czasami oraz postępem prac (%).
            </p>
          </div>
        </div>
      </div>

      <!-- ======================================================= -->
      <!-- SEKCJA 2: TECHNICY (Nowy dział na zarządzanie ekipą)    -->
      <!-- ======================================================= -->
      <div id="sec-tech" class="hidden animate-fade-in">
        <div class="bg-white rounded-lg shadow-sm p-8 border border-gray-100 min-h-[300px]">
          <div class="flex justify-between items-center mb-6 border-b pb-2">
            <h2 class="text-2xl font-bold text-seaviaBlue">Zarządzanie Ekipą</h2>
            <button type="button" onclick="promptAddTechnician()" class="text-sm bg-seaviaBlue hover:bg-blue-900 text-white font-bold py-2 px-4 rounded shadow-sm transition-colors">
              <i class="fa-solid fa-user-plus mr-1"></i> Dodaj nowego pracownika
            </button>
          </div>
          <div class="flex flex-col items-center justify-center text-slate-400 py-12">
            <i class="fa-solid fa-people-group text-5xl mb-4 text-slate-200"></i>
            <p class="font-medium text-lg">Moduł w przygotowaniu</p>
            <p class="text-sm">Tutaj pojawi się lista pracowników, ich dzisiejsza dostępność i suma godzin.</p>
          </div>
        </div>
      </div>

      <!-- ======================================================= -->
      <!-- SEKCJA 3: KARTA ZADAŃ (Główny Formularz)                -->
      <!-- ======================================================= -->
      <div id="sec-tasks" class="hidden animate-fade-in">
        <form id="workForm" onsubmit="submitForm(event)" class="bg-white rounded-lg shadow-sm border border-gray-100">
          
          <!-- Sekcja 1: Użytkownik i Czas -->
          <div class="p-8 border-b border-gray-100">
            <div class="flex justify-between items-center mb-5">
              <h3 class="text-lg font-bold text-seaviaBlue"><i class="fa-regular fa-clock mr-2 text-candidoRed"></i> Dane pracownika i godziny</h3>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Krok 1</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Wybierz pracownika</label>
                <select id="technician" required onchange="onTechOrDateChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-candidoRed focus:border-candidoRed bg-slate-50 font-medium text-slate-700">
                  <option value="" disabled selected>Wybierz z listy...</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Data prac</label>
                <input type="date" id="workDate" required onchange="onTechOrDateChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-candidoRed bg-slate-50 font-medium text-slate-700">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Rozpoczęcie (Start)</label>
                <input type="time" id="timeStart" required onchange="validateTimes()" oninput="validateTimes()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-candidoRed bg-slate-50 font-medium text-slate-700">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Zakończenie (Koniec)</label>
                <input type="time" id="timeEnd" required onchange="validateTimes()" oninput="validateTimes()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-candidoRed bg-slate-50 font-medium text-slate-700">
              </div>

              <!-- Moduł Walidacji i Harmonogramu -->
              <div id="timeErrorMsg" class="col-span-1 md:col-span-2 hidden">
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm font-medium">
                  <span id="timeErrorText"><i class="fa-solid fa-circle-exclamation mr-1"></i> Błąd: ...</span>
                </div>
              </div>

              <div id="scheduleSection" class="col-span-1 md:col-span-2 hidden mt-1">
                 <div class="p-4 bg-slate-50 border border-slate-200 rounded-md">
                   <h4 class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2"><i class="fa-solid fa-list-check mr-1"></i> Dzisiejszy harmonogram pracownika:</h4>
                   <ul id="scheduleList" class="text-sm text-slate-700 space-y-1 font-medium">
                      <!-- Wypełniane dynamicznie -->
                   </ul>
                 </div>
              </div>
            </div>
          </div>

          <!-- Sekcja 2: Zadanie -->
          <div class="p-8 border-b border-gray-100 bg-slate-50">
            <div class="flex justify-between items-center mb-5">
              <h3 class="text-lg font-bold text-seaviaBlue"><i class="fa-solid fa-hammer mr-2 text-candidoRed"></i> Przydział zadania z harmonogramu</h3>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Krok 2</span>
            </div>
            
            <div class="space-y-5">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">1. Wybierz Pokład (Deck)</label>
                <select id="deckSelect" required onchange="onDeckChange()" class="w-full rounded-md border border-slate-300 p-2.5 focus:ring-2 focus:ring-candidoRed bg-white font-medium text-slate-700 shadow-sm">
                  <option value="" disabled selected>Najpierw wybierz pokład...</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">2. Powierzchnia / Obszar</label>
                <select id="areaSelect" required onchange="onAreaChange()" disabled class="w-full rounded-md border border-slate-200 p-2.5 bg-gray-100 opacity-60 font-medium">
                  <option value="" disabled selected>Wybierz powierzchnię...</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">3. Wykonane Zadanie</label>
                <select id="taskSelect" required onchange="onTaskChange()" disabled class="w-full rounded-md border border-slate-200 p-2.5 bg-gray-100 opacity-60 font-medium">
                  <option value="" disabled selected>Wybierz zadanie...</option>
                </select>
                <input type="hidden" id="taskRowNumber">
              </div>
            </div>
          </div>

          <!-- Sekcja 3: Postęp i Zapis -->
          <div id="progressSection" class="p-8 hidden transition-all duration-300">
            <div class="mb-6">
              <h3 class="text-sm font-bold text-seaviaBlue uppercase tracking-wider mb-2">Poziom wykonania zadania (%)</h3>
              <p class="text-xs text-slate-500 mb-4">Wartość zostanie zaaktualizowana w głównej tabeli projektu.</p>
              
              <div class="flex items-center gap-4 bg-white p-4 rounded-md border border-slate-200 shadow-sm">
                <input type="range" id="progressRange" min="0" max="100" step="5" value="0" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-candidoRed" oninput="document.getElementById('progressValue').innerText = this.value + '%'">
                <span id="progressValue" class="text-xl font-bold text-candidoRed min-w-[3rem] text-right">0%</span>
              </div>
            </div>
          </div>

          <div class="p-6 bg-slate-100 rounded-b-lg flex justify-end">
             <button type="submit" id="submitBtn" class="bg-candidoRed hover:bg-red-700 text-white font-bold py-3 px-8 rounded-md shadow-md transition-all flex items-center">
              <span>Zapisz i prześlij</span>
              <i class="fa-solid fa-paper-plane ml-3"></i>
            </button>
          </div>
          
        </form>
      </div>

      <!-- ======================================================= -->
      <!-- SEKCJA 4: RAPORTY (Nowy dział dla generowania podsumowań) -->
      <!-- ======================================================= -->
      <div id="sec-reports" class="hidden animate-fade-in">
        <div class="bg-white rounded-lg shadow-sm p-8 border border-gray-100 min-h-[300px]">
          <h2 class="text-2xl font-bold text-seaviaBlue mb-6 border-b pb-2">Raporty i Timesheety</h2>
          <div class="flex flex-col items-center justify-center text-slate-400 py-12">
            <i class="fa-solid fa-file-pdf text-5xl mb-4 text-slate-200"></i>
            <p class="font-medium text-lg">Moduł w przygotowaniu</p>
            <p class="text-sm">Tutaj zlokalizujemy przyciski do generowania dokumentów i sumowania godzin.</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- ======================================================= -->
  <!-- KOMPONENT: SKRYPTY (LOGIKA APLIKACJI)                   -->
  <!-- ======================================================= -->
  <script>
    let appData = null;
    let currentTechSchedule = [];

    // Inicjalizacja
    window.onload = function() {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('workDate').value = today;
      document.getElementById('infoDate').innerText = new Date().toLocaleDateString('pl-PL');
      fetchData();
    };

    function refreshData() {
      document.getElementById('mainContent').classList.add('hidden');
      document.getElementById('loadingScreen').classList.remove('hidden');
      fetchData();
    }

    function fetchData() {
      google.script.run
        .withSuccessHandler(onDataLoaded)
        .withFailureHandler(err => alert("Błąd pobierania: " + err))
        .getInitialData();
    }

    function onDataLoaded(data) {
      appData = data;
      
      const techSelect = document.getElementById('technician');
      techSelect.innerHTML = '<option value="" disabled selected>Wybierz z listy...</option>';
      data.technicians.forEach(tech => {
        let opt = document.createElement('option');
        opt.value = tech; opt.innerText = tech;
        techSelect.appendChild(opt);
      });

      const deckSelect = document.getElementById('deckSelect');
      let totalTasks = 0;
      
      deckSelect.innerHTML = '<option value="" disabled selected>Najpierw wybierz pokład...</option>';
      Object.keys(data.tasksTree).sort().forEach(deck => {
        let opt = document.createElement('option');
        opt.value = deck; opt.innerText = deck;
        deckSelect.appendChild(opt);
        Object.keys(data.tasksTree[deck]).forEach(area => {
          totalTasks += data.tasksTree[deck][area].length;
        });
      });

      document.getElementById('infoTaskCount').innerText = totalTasks;
      document.getElementById('loadingScreen').classList.add('hidden');
      document.getElementById('mainContent').classList.remove('hidden');
    }

    // Nowa, elastyczna funkcja przełączania zakładek
    function switchTab(tabId) {
      const tabs = ['project', 'tech', 'tasks', 'reports'];
      
      tabs.forEach(id => {
        const section = document.getElementById('sec-' + id);
        const btn = document.getElementById('btn-' + id);
        
        if (id === tabId) {
          // Aktywna zakładka
          section.classList.remove('hidden');
          section.classList.add('block', 'animate-fade-in');
          btn.className = "py-2 px-5 text-seaviaBlue border-b-2 border-seaviaBlue font-bold bg-white rounded-t-md shadow-sm transition-colors whitespace-nowrap";
        } else {
          // Ukryta zakładka
          section.classList.add('hidden');
          section.classList.remove('block', 'animate-fade-in');
          btn.className = "py-2 px-5 text-slate-500 font-medium hover:bg-slate-100 rounded-t-md transition-colors whitespace-nowrap";
        }
      });
    }

    function promptAddTechnician() {
      const name = prompt("Podaj imię i nazwisko nowego pracownika:");
      if (name && name.trim() !== "") {
        refreshData();
        google.script.run
          .withSuccessHandler(response => {
            if(response.success) {
              alert(response.message);
              fetchData();
            } else {
              alert("Błąd: " + response.message);
              fetchData();
            }
          })
          .addTechnician(name);
      }
    }

    function onTechOrDateChange() {
      const tech = document.getElementById('technician').value;
      const date = document.getElementById('workDate').value;
      const scheduleSection = document.getElementById('scheduleSection');
      const scheduleList = document.getElementById('scheduleList');

      resetTimeErrors();

      if (tech && date) {
        scheduleList.innerHTML = '<li class="text-slate-500 italic"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Sprawdzanie harmonogramu...</li>';
        scheduleSection.classList.remove('hidden');

        google.script.run
          .withSuccessHandler(tasks => {
            currentTechSchedule = tasks;
            if (tasks.length === 0) {
              scheduleList.innerHTML = '<li class="text-emerald-600 font-medium"><i class="fa-solid fa-check mr-1"></i> Brak przypisanych prac (czysty grafik).</li>';
            } else {
              scheduleList.innerHTML = tasks.map(t => 
                `<li><span class="text-candidoRed font-bold mr-2">${t.start} - ${t.end}</span> <span class="text-slate-400">|</span> ${t.deck} <span class="text-slate-400">|</span> ${t.taskName}</li>`
              ).join('');
            }
            validateTimes();
          })
          .getTechnicianTasksForDate(tech, date);
      } else {
        scheduleSection.classList.add('hidden');
        currentTechSchedule = [];
      }
    }

    function validateTimes() {
      const timeStart = document.getElementById('timeStart').value;
      const timeEnd = document.getElementById('timeEnd').value;
      
      resetTimeErrors();

      if (!timeStart || !timeEnd) return;

      if (timeStart >= timeEnd) {
        showTimeError('Godzina zakończenia musi być późniejsza niż rozpoczęcia.');
        return;
      }

      let conflictTask = null;
      for (let task of currentTechSchedule) {
        if (timeStart < task.end && timeEnd > task.start) {
          conflictTask = task;
          break;
        }
      }

      if (conflictTask) {
        showTimeError(`Zazębia się z: ${conflictTask.start} - ${conflictTask.end} (${conflictTask.deck}).`);
      }
    }

    function showTimeError(message) {
      document.getElementById('timeErrorText').innerHTML = `<i class="fa-solid fa-circle-exclamation mr-1"></i> ${message}`;
      document.getElementById('timeErrorMsg').classList.remove('hidden');
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed', 'grayscale');
    }

    function resetTimeErrors() {
      document.getElementById('timeErrorMsg').classList.add('hidden');
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'grayscale');
    }

    function onDeckChange() {
      const deck = document.getElementById('deckSelect').value;
      const areaSelect = document.getElementById('areaSelect');
      const taskSelect = document.getElementById('taskSelect');
      
      areaSelect.innerHTML = '<option value="" disabled selected>Wybierz powierzchnię...</option>';
      taskSelect.innerHTML = '<option value="" disabled selected>Wybierz zadanie...</option>';
      taskSelect.disabled = true; taskSelect.classList.add('bg-gray-100', 'opacity-60');
      document.getElementById('progressSection').classList.add('hidden');

      if (deck && appData.tasksTree[deck]) {
        Object.keys(appData.tasksTree[deck]).sort().forEach(area => {
          let opt = document.createElement('option');
          opt.value = area; opt.innerText = area;
          areaSelect.appendChild(opt);
        });
        areaSelect.disabled = false;
        areaSelect.classList.remove('bg-gray-100', 'opacity-60');
        areaSelect.classList.add('bg-white');
      }
    }

    function onAreaChange() {
      const deck = document.getElementById('deckSelect').value;
      const area = document.getElementById('areaSelect').value;
      const taskSelect = document.getElementById('taskSelect');
      
      taskSelect.innerHTML = '<option value="" disabled selected>Wybierz zadanie...</option>';
      document.getElementById('progressSection').classList.add('hidden');

      if (deck && area && appData.tasksTree[deck][area]) {
        appData.tasksTree[deck][area].forEach(t => {
          let opt = document.createElement('option');
          opt.value = t.taskName; opt.innerText = t.taskName;
          opt.dataset.row = t.row; 
          opt.dataset.progress = t.progress;
          taskSelect.appendChild(opt);
        });
        taskSelect.disabled = false;
        taskSelect.classList.remove('bg-gray-100', 'opacity-60');
        taskSelect.classList.add('bg-white');
      }
    }

    function onTaskChange() {
      const select = document.getElementById('taskSelect');
      const opt = select.options[select.selectedIndex];
      
      document.getElementById('taskRowNumber').value = opt.dataset.row;
      
      const prog = opt.dataset.progress || 0;
      document.getElementById('progressRange').value = prog;
      document.getElementById('progressValue').innerText = prog + '%';
      
      document.getElementById('progressSection').classList.remove('hidden');
    }

    function submitForm(event) {
      event.preventDefault();
      
      const timeStart = document.getElementById('timeStart').value;
      const timeEnd = document.getElementById('timeEnd').value;

      if (timeStart >= timeEnd) {
        showTimeError('Godziny są niepoprawne!'); return;
      }
      for (let t of currentTechSchedule) {
        if (timeStart < t.end && timeEnd > t.start) {
          alert("Harmonogram uległ zmianie - konflikt godzin!"); return;
        }
      }

      const btn = document.getElementById('submitBtn');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Zapisywanie...';
      btn.disabled = true;

      const formData = {
        technician: document.getElementById('technician').value,
        workDate: document.getElementById('workDate').value,
        timeStart: timeStart,
        timeEnd: timeEnd,
        deck: document.getElementById('deckSelect').value,
        area: document.getElementById('areaSelect').value,
        taskName: document.getElementById('taskSelect').value,
        taskRow: document.getElementById('taskRowNumber').value,
        progress: document.getElementById('progressRange').value
      };

      google.script.run
        .withSuccessHandler(res => {
          if (res.success) {
            alert(res.message);
            onTechOrDateChange();
            document.getElementById('deckSelect').value = "";
            document.getElementById('timeStart').value = ""; 
            document.getElementById('timeEnd').value = "";
            onDeckChange(); 
          } else {
            alert("Błąd: " + res.message);
          }
          btn.innerHTML = '<span>Zapisz i prześlij</span><i class="fa-solid fa-paper-plane ml-3"></i>';
          btn.disabled = false;
        })
        .submitWorkReport(formData);
    }
  </script>
</body>
</html>
