  <script>
    function switchTab(tabId) {
      // WAŻNE: Dodano 'timesheet' do tablicy
      const tabs = ['project', 'tech', 'tasks', 'reports', 'koszty', 'timesheet'];
      tabs.forEach(id => {
        const section = document.getElementById('sec-' + id);
        const btn = document.getElementById('btn-' + id);
        if (section && btn) {
          if (id === tabId) {
            section.classList.remove('hidden');
            section.classList.add('block');
            btn.className = "py-2 px-5 text-seaviaBlue border-b-2 border-seaviaBlue font-bold bg-white rounded-t-md shadow-sm transition-colors whitespace-nowrap";
          } else {
            section.classList.add('hidden');
            section.classList.remove('block');
            btn.className = "py-2 px-5 text-slate-500 font-medium hover:bg-gray-100 rounded-t-md transition-colors whitespace-nowrap";
          }
        }
      });
    }
  </script>
  
