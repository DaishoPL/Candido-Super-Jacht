<div class="bg-white rounded-lg shadow-sm p-4 md:p-8 border border-gray-100 animate-fade-in">
  <!-- Nagłówek Komponentu -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 border-b pb-4 gap-4">
    <div>
      <h2 class="text-2xl font-bold text-seaviaBlue">
        <i class="fa-solid fa-wallet mr-2 text-candidoRed"></i> Rejestracja Kosztów i Rachunków
      </h2>
      <p class="text-sm text-slate-500 mt-1">Dodaj paragony, faktury oraz inne wydatki bezpośrednio do archiwum projektu.</p>
    </div>
    <!-- Link do folderu na Google Drive -->
    <a href="https://drive.google.com/drive/folders/1dtvg-bx_ePiMfsuf2kf0vGadlzNgHeeI?usp=drive_link" 
       target="_blank" 
       class="w-full md:w-auto bg-slate-100 hover:bg-slate-200 text-seaviaBlue font-bold py-2.5 px-4 rounded text-xs transition-all flex items-center justify-center border border-slate-200 shadow-sm">
      <i class="fa-solid fa-folder-open mr-2 text-amber-500"></i> Otwórz folder rachunków <i class="fa-solid fa-arrow-up-right-from-square ml-1.5 opacity-60"></i>
    </a>
  </div>

  <!-- Formularz Dodawania Kosztu -->
  <form id="costForm" onsubmit="saveCost(event)" class="max-w-2xl mx-auto bg-slate-50 p-6 rounded-lg border border-slate-200">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Pole: Nazwa kosztu -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nazwa Kosztu / Opis</label>
        <input type="text" id="costName" required placeholder="np. Klej, profile, drobne narzędzia" 
               class="w-full border border-slate-300 rounded p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-white font-medium text-slate-700">
      </div>
      <!-- Pole: Data kosztu -->
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Data Kosztu</label>
        <input type="date" id="costDate" required 
               class="w-full border border-slate-300 rounded p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-white font-medium text-slate-700">
      </div>
    </div>

    <!-- Sekcja załączników / plików -->
    <div class="mb-6">
      <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">Załączniki (Zdjęcia, PDF lub Paragony)</label>
      
      <!-- Ukryte natywne inputy plików (multiple dodane do fileInput) -->
      <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden" onchange="handleFileSelected(this)">
      <input type="file" id="fileInput" accept="image/*,application/pdf" class="hidden" multiple onchange="handleFileSelected(this)">

      <!-- Przyciski wyboru źródła pliku -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Przycisk Aparatu -->
        <button type="button" onclick="triggerCamera()" 
                class="bg-seaviaBlue hover:bg-[#0a1e38] text-white font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm gap-2">
          <i class="fa-solid fa-camera text-base"></i> Zrób zdjęcie (Aparat)
        </button>
        <!-- Przycisk wyboru z urządzenia -->
        <button type="button" onclick="triggerFileSelect()" 
                class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm gap-2 border border-slate-300">
          <i class="fa-solid fa-file-import text-base text-seaviaBlue"></i> Wybierz pliki z urządzenia
        </button>
      </div>
    </div>

    <!-- Podgląd wybranych plików -->
    <div id="filePreviewContainer" class="hidden bg-white border border-slate-200 rounded-lg p-4 mb-6 animate-fade-in shadow-inner">
      <div class="flex items-center justify-between border-b pb-2 mb-3">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Wybrane pliki</span>
        <button type="button" onclick="clearFileSelection()" class="text-slate-400 hover:text-red-500 transition-colors text-xs flex items-center gap-1">
          <i class="fa-solid fa-circle-xmark"></i> Usuń wszystkie
        </button>
      </div>
      <div id="filesListContainer" class="flex flex-col gap-3">
        <!-- Dynamicznie wstrzykiwane pliki przez JS -->
      </div>
    </div>

    <!-- Przyciski akcji -->
    <div class="flex justify-end gap-3 border-t border-slate-200 pt-5">
      <button type="submit" id="saveCostBtn" 
              class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-6 rounded shadow-sm transition-all flex items-center justify-center text-sm gap-2">
        <span>Zapisz koszt</span> <i class="fa-solid fa-cloud-arrow-up text-base"></i>
      </button>
    </div>
  </form>
</div>

<script>
  let activeSelectedFiles = [];

  // Ustawienie domyślnej dzisiejszej daty kosztu przy załadowaniu komponentu
  document.addEventListener("DOMContentLoaded", () => {
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.getElementById('costDate');
    if (dateInput) dateInput.value = today;
  });

  // Obsługa wyzwalania natywnych inputów
  function triggerCamera() {
    document.getElementById('cameraInput').click();
  }

  function triggerFileSelect() {
    document.getElementById('fileInput').click();
  }

  // Obsługa wczytania i podglądu wybranych plików
  function handleFileSelected(input) {
    const files = Array.from(input.files);
    if (files.length === 0) return;

    // Dodanie nowych plików do aktualnie wybranej listy
    activeSelectedFiles = activeSelectedFiles.concat(files);
    renderFilesPreview();
  }

  // Renderowanie listy wybranych plików z opcją usuwania każdego z osobna
  function renderFilesPreview() {
    const previewContainer = document.getElementById('filePreviewContainer');
    const filesListContainer = document.getElementById('filesListContainer');
    if (!previewContainer || !filesListContainer) return;

    if (activeSelectedFiles.length === 0) {
      previewContainer.classList.add('hidden');
      return;
    }

    let html = '';
    activeSelectedFiles.forEach((file, index) => {
      const fileSizeMB = (file.size / 1024 / 1024).toFixed(2);
      const isImage = file.type.startsWith('image/');

      html += `
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-md border border-slate-200 gap-4">
          <div class="flex items-center gap-3 overflow-hidden">
            <div class="w-12 h-12 bg-white rounded border border-slate-200 flex items-center justify-center overflow-hidden shrink-0">
              ${isImage ? `<img src="${URL.createObjectURL(file)}" class="w-full h-full object-cover" />` : `<i class="fa-solid fa-file-pdf text-2xl text-red-500"></i>`}
            </div>
            <div class="overflow-hidden">
              <p class="text-sm font-bold text-slate-700 truncate max-w-[200px]" title="${file.name}">${file.name}</p>
              <p class="text-xs text-slate-400">${fileSizeMB} MB</p>
            </div>
          </div>
          <button type="button" onclick="removeFileFromSelection(${index})" class="text-slate-400 hover:text-red-500 p-1.5 transition-colors" title="Usuń plik">
            <i class="fa-solid fa-trash-can text-sm"></i>
          </button>
        </div>
      `;
    });

    filesListContainer.innerHTML = html;
    previewContainer.classList.remove('hidden');
  }

  // Usunięcie wybranego pliku z listy
  function removeFileFromSelection(index) {
    activeSelectedFiles.splice(index, 1);
    renderFilesPreview();
  }

  // Wyczyszczenie całego wyboru
  function clearFileSelection() {
    document.getElementById('cameraInput').value = "";
    document.getElementById('fileInput').value = "";
    activeSelectedFiles = [];
    renderFilesPreview();
  }

  // Zapisanie kosztu i sekwencyjny upload wszystkich plików
  function saveCost(event) {
    event.preventDefault();
    const costName = document.getElementById('costName').value.trim();
    const costDate = document.getElementById('costDate').value;

    if (!costName) { alert("Podaj nazwę lub opis kosztu!"); return; }
    if (!costDate) { alert("Wybierz datę kosztu!"); return; }
    if (activeSelectedFiles.length === 0) { alert("Zrób zdjęcie lub dodaj pliki paragonu/faktury!"); return; }

    const submitBtn = document.getElementById('saveCostBtn');
    submitBtn.disabled = true;

    let uploadIndex = 0;

    // Funkcja pomocnicza do sekwencyjnego przesyłania plików
    function uploadNextFile() {
      if (uploadIndex >= activeSelectedFiles.length) {
        // Wszystkie pliki zostały pomyślnie wysłane
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Zapisz koszt</span> <i class="fa-solid fa-cloud-arrow-up text-base"></i>';
        
        alert(`Pomyślnie zapisano koszt oraz przesłano ${activeSelectedFiles.length} plik(ów) do archiwum!`);
        document.getElementById('costForm').reset();
        clearFileSelection();
        
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('costDate').value = today;
        return;
      }

      const file = activeSelectedFiles[uploadIndex];
      submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-2"></i> Przesyłanie ${uploadIndex + 1} z ${activeSelectedFiles.length}...`;

      const reader = new FileReader();
      reader.onload = function(e) {
        const base64Data = e.target.result;

        google.script.run
          .withSuccessHandler(res => {
            if (res && res.success) {
              uploadIndex++;
              uploadNextFile(); // Wywołanie kolejnego pliku
            } else {
              alert(`Błąd przesyłania pliku "${file.name}": ` + (res ? res.message : "Brak odpowiedzi serwera."));
              resetSaveButton();
            }
          })
          .withFailureHandler(err => {
            alert(`Błąd komunikacji przy pliku "${file.name}": ` + err);
            resetSaveButton();
          })
          .uploadCostFile(base64Data, file.name, costName, costDate);
      };
      reader.readAsDataURL(file);
    }

    function resetSaveButton() {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Zapisz koszt</span> <i class="fa-solid fa-cloud-arrow-up text-base"></i>';
    }

    // Rozpoczęcie wysyłania pierwszego pliku
    uploadNextFile();
  }
</script>
