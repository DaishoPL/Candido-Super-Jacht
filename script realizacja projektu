<!-- Pobieramy bibliotekę Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  let mainChartInstance = null;

  // Ta funkcja będzie wywołana z głównego Scripts.html po pobraniu danych
  function initDashboard(data) {
    console.log("=== INIT DASHBOARD WYZWOLONY ===", data);

    // Zabezpieczenie: Jeśli brakuje głównego obiektu danych
    if (!data) {
      console.error("BŁĄD KRYTYCZNY: Z backendu przyszło 'null'.");
      if(document.getElementById('dashTotalProgress')) document.getElementById('dashTotalProgress').innerText = "BŁĄD";
      if(document.getElementById('dashTotalHours')) document.getElementById('dashTotalHours').innerText = "Brak połączenia";
      return;
    }

    if (!data.tasksTree) {
      console.warn("UWAGA: Brak tasksTree w otrzymanych danych.");
      return;
    }

    try {
      // 1. Zasilenie górnych liczników z techników (bezpieczne przypisanie)
      if (data.techStats) {
        const elTotalTechs = document.getElementById('dashTotalTechs');
        const elActiveTechs = document.getElementById('dashActiveTechs');
        if (elTotalTechs) elTotalTechs.innerText = data.techStats.total || 0;
        if (elActiveTechs) elActiveTechs.innerText = data.techStats.active || 0;
      }
      
      // 2. Całkowite godziny z backendu
      const elTotalHours = document.getElementById('dashTotalHours');
      if (elTotalHours) {
        elTotalHours.innerText = Math.round(data.totalWorkedHours || 0) + 'h';
      }

      // 3. Zaawansowana matematyka: Średnia ważona czasu
      let totalProjectPlannedDays = 0;
      let weightedProgressSum = 0;
      let hoursByDeck = {};

      Object.keys(data.tasksTree).forEach(deck => {
        let deckHours = 0;

        Object.keys(data.tasksTree[deck]).forEach(area => {
          data.tasksTree[deck][area].forEach(task => {
            
            // Wymuszamy liczby zmiennoprzecinkowe, by uniknąć błędów
            let weight = parseFloat(task.plannedDays) || 1; 
            let progress = parseFloat(task.progress) || 0;
            let hours = parseFloat(task.workedHours) || 0;
            
            // Do całkowitego postępu
            totalProjectPlannedDays += weight;
            weightedProgressSum += (progress * weight);

            // Do wykresu głównego (Suma godzin na pokład)
            deckHours += hours;
          });
        });

        if (deckHours > 0) hoursByDeck[deck] = deckHours;
      });

      // Wyliczenie % całości na bazie wagi czasowej
      let finalProjectProgress = 0;
      if (totalProjectPlannedDays > 0) {
        finalProjectProgress = Math.round(weightedProgressSum / totalProjectPlannedDays);
      }
      
      const elTotalProgress = document.getElementById('dashTotalProgress');
      if (elTotalProgress) {
        elTotalProgress.innerText = finalProjectProgress + '%';
      }

      // 4. Rysowanie Głównego Wykresu Pierścieniowego
      drawMainChart(hoursByDeck);

    } catch (error) {
      console.error("Błąd podczas renderowania pulpitu:", error);
      if(document.getElementById('dashTotalProgress')) {
         document.getElementById('dashTotalProgress').innerText = "BŁĄD JS";
      }
    }
  }

  function drawMainChart(hoursByDeck) {
    const ctx = document.getElementById('mainProjectChart');
    if (!ctx) {
      console.warn("Brak elementu canvas o id 'mainProjectChart'");
      return;
    }

    if (mainChartInstance) {
      mainChartInstance.destroy();
    }

    const labels = Object.keys(hoursByDeck);
    const dataValues = Object.values(hoursByDeck).map(v => Math.round(v));
    
    // Jeśli nie ma żadnych godzin, nie rysujemy pustego "niewidzialnego" wykresu
    if (labels.length === 0) {
      console.log("Brak godzin do narysowania na wykresie.");
      document.getElementById('centerChartHours').innerText = '0h';
      return;
    }

    // Ładne palety kolorów dla pokładów
    const bgColors = ['#0f2d52', '#e53e3e', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#64748b'];

    mainChartInstance = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: dataValues,
          backgroundColor: bgColors.slice(0, labels.length),
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '70%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { padding: 20, font: { family: 'Inter', size: 12 } },
            onClick: function(e, legendItem, legend) {
              Chart.defaults.plugins.legend.onClick.call(this, e, legendItem, legend);
              updateCenterHours(legend.chart);
            }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return ' ' + context.label + ': ' + context.raw + 'h';
              }
            }
          }
        },
        animation: {
          onComplete: function(animation) {
             updateCenterHours(animation.chart);
          }
        }
      }
    });
  }

  function updateCenterHours(chart) {
    let total = 0;
    if (chart && chart.data && chart.data.datasets && chart.data.datasets[0]) {
      chart.data.datasets[0].data.forEach((val, index) => {
        if (chart.getDataVisibility(index)) {
          total += val;
        }
      });
    }
    const centerEl = document.getElementById('centerChartHours');
    if (centerEl) centerEl.innerText = total + 'h';
  }
</script>