<!-- Wymagane biblioteki do eksportu (PDF) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="bg-white rounded-lg shadow-sm p-4 md:p-8 border border-gray-100 animate-fade-in">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 border-b pb-4 gap-4">
    <div>
      <h2 class="text-2xl font-bold text-seaviaBlue"><i class="fa-solid fa-file-contract mr-2 text-candidoRed"></i> Centrum Raportowania</h2>
      <p class="text-sm text-slate-500 mt-1">Generuj zbiorcze rozliczenia godzinowe lub indywidualne Karty Pracy techników.</p>
    </div>
  </div>

  <!-- Panel Sterowania podzielony na 3 ergonomiczne wiersze -->
  <div class="bg-slate-50 p-5 rounded-lg border border-slate-200 mb-8 flex flex-col gap-6">
    <!-- Wiersz 1: Ustawienie daty Od-Do i płatnych przerw -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end w-full">
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Data od (Poniedziałek / Dowolny dzień)</label>
        <input type="date" id="reportDate" onchange="adjustWeekDates()" class="w-full border border-slate-300 rounded p-2.5 focus:ring-2 focus:ring-seaviaBlue bg-white font-medium text-slate-700">
      </div>
      <div>
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Data do (Niedziela włącznie)</label>
        <input type="date" id="reportDateTo" disabled class="w-full border border-slate-300 rounded p-2.5 bg-slate-100 font-medium text-slate-500 cursor-not-allowed">
      </div>
      <div class="flex items-center h-[46px] pb-1">
        <label class="flex items-center space-x-2 cursor-pointer group">
          <input type="checkbox" id="reportIncludeBreaks" class="w-5 h-5 rounded text-seaviaBlue focus:ring-seaviaBlue border-slate-300">
          <span class="text-sm font-bold text-slate-700 group-hover:text-seaviaBlue transition-colors">Wliczaj płatne przerwy (Breaks) do sumy czasu</span>
        </label>
      </div>
    </div>

    <!-- Wiersz 2: Przyciski generowania raportów -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 w-full">
      <button onclick="fetchWeeklyReport()" id="btnGenerateReport" class="w-full bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm">
        <i class="fa-solid fa-table-list mr-2 text-seaviaBlue"></i> Czas na pokładach
      </button>
      <button onclick="fetchTimeByWeekReport()" id="btnGenerateTimeByWeekReport" class="w-full bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm">
        <i class="fa-solid fa-calendar-week mr-2 text-seaviaBlue"></i> Czas w tygodniach
      </button>
      <button onclick="fetchTechnicianTimesheets()" id="btnGenerateTimesheets" class="w-full bg-seaviaBlue hover:bg-[#0a1e38] text-white font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm">
        <i class="fa-solid fa-users-viewfinder mr-2"></i> Karty pracy PDF
      </button>
    </div>
  </div>

  <!-- Kontener raportu wraz z równej szerokości przyciskami eksportu -->
  <div id="reportContainer" class="hidden">
    <!-- Przyciski Pobierania - Wiersz 3 (Zsynchronizowane i o równej szerokości) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 border-b border-slate-200 pb-6">
      <button onclick="exportToExcel()" id="btnExportExcel" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm">
        <i class="fa-solid fa-file-excel mr-2"></i> Pobierz XLSX
      </button>
      <button onclick="exportToPDF()" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-5 rounded shadow-sm transition-all flex items-center justify-center text-sm">
        <i class="fa-solid fa-file-pdf mr-2"></i> Pobierz PDF
      </button>
    </div>
    <div id="reportContent" class="bg-white p-2 sm:p-6 mx-auto max-w-5xl"></div>
  </div>
</div>

<script>
  let currentReportData = null;
  let currentReportType = 'weekly';

  document.addEventListener("DOMContentLoaded", () => {
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.getElementById('reportDate');
    if (dateInput) {
      dateInput.value = today;
      adjustWeekDates();
    }
  });

  // Automatyczne ustawianie daty Od na Poniedziałek i Do na Niedzielę
  function adjustWeekDates() {
    const fromInput = document.getElementById('reportDate');
    const toInput = document.getElementById('reportDateTo');
    if (!fromInput || !toInput || !fromInput.value) return;

    // Bezpieczne parsowanie daty lokalnej
    const parts = fromInput.value.split('-');
    const selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
    if (isNaN(selectedDate.getTime())) return;

    const day = selectedDate.getDay(); // 0 = Niedziela, 1 = Poniedziałek, ..., 6 = Sobota
    // Oblicz dni do poniedziałku i niedzieli tego samego tygodnia
    const daysToMonday = day === 0 ? -6 : 1 - day;
    const mondayDate = new Date(selectedDate);
    mondayDate.setDate(selectedDate.getDate() + daysToMonday);

    const sundayDate = new Date(mondayDate);
    sundayDate.setDate(mondayDate.getDate() + 6);

    const formatDate = (d) => {
      const yyyy = d.getFullYear();
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      return `${yyyy}-${mm}-${dd}`;
    };

    // Ustawiamy wartości w polach
    fromInput.value = formatDate(mondayDate);
    toInput.value = formatDate(sundayDate);
  }

  function fetchWeeklyReport() {
    const dateStr = document.getElementById('reportDate').value;
    const includeBreaks = document.getElementById('reportIncludeBreaks').checked;
    const btn = document.getElementById('btnGenerateReport');
    if (!dateStr) { alert("Wybierz datę!"); return; }

    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Pobieranie...';
    btn.disabled = true;

    google.script.run
      .withSuccessHandler(data => {
        currentReportType = 'weekly';
        currentReportData = data;
        renderReport(data); 
        btn.innerHTML = '<i class="fa-solid fa-table-list mr-2 text-seaviaBlue"></i> Czas na pokładach';
        btn.disabled = false;
      })
      .withFailureHandler(err => {
        alert("Błąd: " + err);
        btn.innerHTML = '<i class="fa-solid fa-table-list mr-2 text-seaviaBlue"></i> Czas na pokładach';
        btn.disabled = false;
      })
      .getCandidoWeeklyReport(dateStr, includeBreaks);
  }

  function fetchTimeByWeekReport() {
    const includeBreaks = document.getElementById('reportIncludeBreaks').checked;
    const btn = document.getElementById('btnGenerateTimeByWeekReport');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Przetwarzanie...';
    btn.disabled = true;

    google.script.run
      .withSuccessHandler(data => {
        currentReportType = 'timeByWeek';
        currentReportData = data;
        renderTimeByWeekReport(data); 
        btn.innerHTML = '<i class="fa-solid fa-calendar-week mr-2 text-seaviaBlue"></i> Czas w tygodniach';
        btn.disabled = false;
      })
      .withFailureHandler(err => {
        alert("Błąd: " + err);
        btn.innerHTML = '<i class="fa-solid fa-calendar-week mr-2 text-seaviaBlue"></i> Czas w tygodniach';
        btn.disabled = false;
      })
      .getTimeByWeekReport(includeBreaks);
  }

  function fetchTechnicianTimesheets() {
    const dateStr = document.getElementById('reportDate').value;
    const includeBreaks = document.getElementById('reportIncludeBreaks').checked;
    const btn = document.getElementById('btnGenerateTimesheets');
    if (!dateStr) { alert("Wybierz datę z tygodnia!"); return; }

    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Przygotowuję karty...';
    btn.disabled = true;

    google.script.run
      .withSuccessHandler(data => {
        if (!data || Object.keys(data.technicians).length === 0) {
          alert("Brak przepracowanych godzin przez techników w wybranym tygodniu.");
          btn.innerHTML = '<i class="fa-solid fa-users-viewfinder mr-2"></i> Karty pracy PDF';
          btn.disabled = false;
          return;
        }
        btn.innerHTML = '<i class="fa-solid fa-file-pdf mr-2"></i> Generowanie PDF...';
        generateTechnicianPDFs(data, btn);
      })
      .withFailureHandler(err => {
        alert("Błąd: " + err);
        btn.innerHTML = '<i class="fa-solid fa-users-viewfinder mr-2"></i> Karty pracy PDF';
        btn.disabled = false;
      })
      .getTechnicianWeeklyReports(dateStr, includeBreaks);
  }

  function generateTechnicianPDFs(data, btnElement) {
    window.scrollTo(0, 0);
    setTimeout(() => {
      const dayNames = ["MON.", "TUE.", "WED.", "THU.", "FRI.", "SAT.", "SUN."];
      let html = `
        <style>
          .ts-container { font-family: Arial, sans-serif; background-color: #ffffff; width: 1050px; color: #000000; } .ts-page { padding: 20px; page-break-after: always; box-sizing: border-box; background-color: #ffffff; } .ts-page:last-child { page-break-after: auto; } .ts-logo-bar { background-color: #4a4a4a; color: white; padding: 10px 15px; display: flex; align-items: center; justify-content: flex-start; margin-bottom: 5px; position: relative;} .ts-logo-bar::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 30%; background-color: #555555; clip-path: polygon(20px 0, 100% 0, 100% 100%, 0 100%); } .ts-logo-text { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 20px; letter-spacing: 2px; position: relative; z-index: 10;} .ts-logo-text span { font-weight: bold; } .ts-address { font-size: 9px; color: #666; margin-bottom: 15px; padding-left: 5px;} .ts-title { font-weight: bold; font-size: 14px; margin-bottom: 5px; } .ts-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; } .ts-table th, .ts-table td { border: 1px solid #333; padding: 4px 6px; text-align: left; vertical-align: middle; } .ts-info td { padding: 4px 6px; } .ts-label { font-weight: bold; font-size: 11px; width: 80px; border-right: none;} .ts-value { border-left: none; font-size: 11px;} .ts-grid th { background-color: #e8e8e8; font-weight: normal; text-align: center; font-size: 10px; padding: 6px;} .ts-grid td.day-col { width: 50px; font-weight: bold; font-size: 10px; vertical-align: middle; text-align: center;} .ts-grid td { font-size: 10px; height: 25px;} .ts-center { text-align: center; vertical-align: middle !important;} .ts-total td { background-color: #e8e8e8; font-weight: bold; font-size: 11px;} .ts-signs { display: flex; justify-content: space-around; margin-top: 30px; font-size: 11px;} .ts-sign-box { text-align: center; width: 250px; } .ts-sign-line { border-bottom: 1px solid #333; margin-bottom: 5px; height: 25px; }
        </style>
        <div class="ts-container">`;

      Object.keys(data.technicians).sort().forEach(techName => {
        let tech = data.technicians[techName];
        html += `
          <div class="ts-page">
            <div class="ts-logo-bar"><div class="ts-logo-text"><span>CÁNDIDO</span> HERMIDA</div></div>
            <div class="ts-address">Industrias Cándido Hermida, S.L CIF: B15057474 Pol. Ind. Rio do Pozo, Avda. Bernardo Romero, Parcela G2, 15570 Narón, A Coruña, España.</div>
            <div class="ts-title">HOUR LIST</div>
            <table class="ts-table ts-info">
              <tr><td class="ts-label">COMPANY:</td><td class="ts-value">SEAVIA</td><td class="ts-label">SHIPYARD:</td><td class="ts-value">DAMEN</td><td class="ts-label" style="width: 100px;">PROJECT:</td><td class="ts-value font-bold">REV OCEAN 19577</td></tr>
              <tr><td class="ts-label">WORKER:</td><td colspan="5" class="ts-value" style="font-weight: bold; text-transform: uppercase;">${techName}</td></tr>
              <tr><td class="ts-label">WEEK:</td><td class="ts-value" colspan="2">${data.weekInfo.weekNumber}</td><td class="ts-label">YEAR:</td><td class="ts-value" colspan="2">${data.weekInfo.year}</td></tr>
            </table>
            <table class="ts-table ts-grid">
              <thead><tr><th width="8%"></th><th width="12%">DATE</th><th width="8%">FROM</th><th width="8%">TO</th><th width="8%">HOURS</th><th width="32%">TASK</th><th width="10%">DECK</th><th width="14%">ROOM</th></tr></thead>
              <tbody>`;
        
        tech.days.forEach((tasksArray, dayIndex) => {
          let dName = dayNames[dayIndex];
          let dDate = data.weekInfo.dates[dayIndex].split('-').reverse().join('.'); 
          if (tasksArray.length === 0) {
            html += `<tr><td class="day-col">${dName}</td><td class="ts-center">${dDate}</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>`;
          } else {
            tasksArray.forEach((t, index) => {
              html += `<tr>`;
              if (index === 0) {
                html += `<td class="day-col" rowspan="${tasksArray.length}">${dName}</td>`;
                html += `<td class="ts-center" rowspan="${tasksArray.length}">${dDate}</td>`;
              }
              html += `<td class="ts-center">${t.start}</td><td class="ts-center">${t.end}</td><td class="ts-center font-bold">${t.hours.toFixed(1)}</td><td>${t.task}</td><td class="ts-center">${t.deck}</td><td class="ts-center">${t.roomId || '-'}</td></tr>`;
            });
          }
        });
        html += `<tr class="ts-total"><td class="day-col">TOTAL</td><td></td><td></td><td></td><td class="ts-center">${tech.totalHours.toFixed(1)}</td><td></td><td></td><td></td></tr></tbody></table>
            <div class="ts-signs">
              <div class="ts-sign-box"><div class="ts-sign-line"></div>SUBCONTRACTOR SIGNATURE</div>
              <div class="ts-sign-box"><div class="ts-sign-line"></div>CH RESPONSIBLE SIGNATURE</div>
            </div>
          </div>`;
      });
      html += `</div>`;
      
      const opt = { margin: 0.3, filename: `Karty_Pracy_Seavia_W${data.weekInfo.weekNumber}_${data.weekInfo.year}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff' }, jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' } };
      
      html2pdf().set(opt).from(html).save().then(() => {
        btnElement.innerHTML = '<i class="fa-solid fa-users-viewfinder mr-2"></i> Karty pracy PDF';
        btnElement.disabled = false;
      });
    }, 0);
  }

  function renderReport(data) {
    const container = document.getElementById('reportContainer');
    const content = document.getElementById('reportContent');
    
    if (!data || Object.keys(data.decks).length === 0) {
      content.innerHTML = '<div class="text-center text-slate-500 py-8 font-medium bg-slate-50 rounded-lg"><i class="fa-solid fa-folder-open text-3xl mb-3 block"></i>Brak wykonanych prac w wybranym tygodniu.</div>';
      container.classList.remove('hidden');
      return;
    }
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    let html = `<div class="bg-white p-3 border border-slate-300 mb-8 w-max min-w-[320px]"><p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-2 border-b border-slate-100 pb-1">Szczegóły raportu</p><div class="grid grid-cols-2 gap-x-6 gap-y-1 text-xs"><span class="font-bold text-slate-700">Project name:</span> <span class="text-right text-seaviaBlue font-bold">REV OCEAN 19577</span><span class="font-bold text-slate-700">Week no.:</span> <span class="text-right text-seaviaBlue font-bold">${data.weekInfo.weekNumber}</span><span class="font-bold text-slate-700">Date range:</span> <span class="text-right font-mono">${data.weekInfo.start} / ${data.weekInfo.end}</span><span class="font-bold text-slate-700">Paid Breaks:</span> <span class="text-right ${data.settings.includeBreaks ? 'text-emerald-600' : 'text-slate-400'} font-bold">${data.settings.includeBreaks ? 'YES' : 'NO'}</span></div></div><div class="flex flex-col gap-y-10" id="pdf-export-wrapper">`;

    Object.keys(data.decks).sort().forEach(deckName => {
      let deckData = data.decks[deckName].tasks || {};
      html += `<div class="report-page w-full bg-white border border-slate-300 shadow-sm"><div class="bg-slate-100 p-2 border-b border-slate-300"><h3 class="font-black text-seaviaBlue text-[11px] uppercase tracking-wider">WEEKLY SUM ${deckName}</h3></div><div class="overflow-x-auto"><table class="w-full text-left border-collapse text-[10px] sm:text-[11px]"><thead><tr class="bg-slate-50 text-slate-600"><th class="p-1 border-b border-r border-slate-300 text-center w-8">No.</th><th class="p-1 border-b border-r border-slate-300 min-w-[180px]">Tasks</th><th class="p-1 border-b border-r border-slate-300 text-center w-12 font-bold bg-slate-200">Total</th>${days.map((d, i) => `<th class="p-1 border-b ${i < 6 ? 'border-r' : ''} border-slate-300 text-center w-10">${d}</th>`).join('')}</tr></thead><tbody>`;

      const renderRow = (taskName, index) => {
        let hours = deckData[taskName] || [0, 0, 0, 0, 0, 0, 0];
        let total = hours.reduce((a, b) => a + b, 0);
        
        let rowHtml = `<tr class="border-b border-slate-200 hover:bg-blue-50/50"><td class="p-1 border-r border-slate-300 text-center text-slate-500 font-medium">${index}</td><td class="p-1 border-r border-slate-300 font-bold text-slate-700 leading-tight">${taskName}</td>`;
        let totalClass = total > 0 ? 'bg-green-200 text-green-900 font-black' : 'bg-slate-100 text-slate-400';
        rowHtml += `<td class="p-1 border-r border-slate-300 text-center ${totalClass}">${total > 0 ? total.toFixed(1) : '0'}</td>`;
        
        hours.forEach((h, i) => {
          let cellClass = h > 0 ? 'bg-green-100 text-green-800 font-black' : 'text-slate-300';
          rowHtml += `<td class="p-1 ${i < 6 ? 'border-r' : ''} border-slate-300 text-center ${cellClass}">${h > 0 ? h.toFixed(1) : '0'}</td>`;
        });
        rowHtml += `</tr>`;
        return rowHtml;
      };

      // Supervision pojawia się na każdym pokładzie oprócz pokładu TRAVEL
      if (deckName !== "TRAVEL") {
        html += renderRow("Supervision", 0);
      }

      let filteredTasks = data.allTasks;
      if (!data.settings.includeBreaks) {
        filteredTasks = filteredTasks.filter(t => !t.toLowerCase().includes('break') && !t.toLowerCase().includes('przerwa'));
      }

      // Zadanie travel widoczne wyłącznie na pokładzie TRAVEL, na innych ukryte
      if (deckName === "TRAVEL") {
        filteredTasks = filteredTasks.filter(t => t.toLowerCase() === "travel");
      } else {
        filteredTasks = filteredTasks.filter(t => t.toLowerCase() !== "travel");
      }

      let taskIndex = 1;
      filteredTasks.forEach(taskName => {
        if (taskName !== "Supervision") {
          html += renderRow(taskName, taskIndex++);
        }
      });
      html += `</tbody></table></div></div>`;
    });

    // --- SEKCJA PRACE DODATKOWE (EXTRA JOBS) NA SAMYM DOLE ---
    if (data.extraTasks && data.extraTasks.length > 0) {
      html += `
      <div class="report-page w-full bg-white border border-slate-300 shadow-sm mt-10">
        <div class="bg-red-50 p-2 border-b border-slate-300">
            <h3 class="font-black text-red-700 text-[11px] uppercase tracking-wider">PRACE DODATKOWE (EXTRA JOBS)</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[10px] sm:text-[11px]">
                <thead>
                    <tr class="bg-slate-50 text-slate-600">
                        <th class="p-1 border-b border-r border-slate-300 text-center w-8">No.</th>
                        <th class="p-1 border-b border-r border-slate-300 min-w-[180px]">Tasks</th>
                        <th class="p-1 border-b border-r border-slate-300 text-center w-12 font-bold bg-slate-200">Total</th>
                        ${days.map((d, i) => `<th class="p-1 border-b ${i < 6 ? 'border-r' : ''} border-slate-300 text-center w-10">${d}</th>`).join('')}
                    </tr>
                </thead>
                <tbody>
      `;

      let extraTaskIndex = 1;
      data.extraTasks.forEach(taskName => {
        let hours = data.extraDeck.tasks[taskName] || [0, 0, 0, 0, 0, 0, 0];
        let total = hours.reduce((a, b) => a + b, 0);

        let rowHtml = `<tr class="border-b border-slate-200 hover:bg-red-50/30">
            <td class="p-1 border-r border-slate-300 text-center text-slate-500 font-medium">${extraTaskIndex++}</td>
            <td class="p-1 border-r border-slate-300 font-bold text-red-600 leading-tight">${taskName}</td>`;

        let totalClass = total > 0 ? 'bg-green-200 text-green-900 font-black' : 'bg-slate-100 text-slate-400';
        rowHtml += `<td class="p-1 border-r border-slate-300 text-center ${totalClass}">${total > 0 ? total.toFixed(1) : '0'}</td>`;

        hours.forEach((h, i) => {
          let cellClass = h > 0 ? 'bg-green-100 text-green-800 font-black' : 'text-slate-300';
          rowHtml += `<td class="p-1 ${i < 6 ? 'border-r' : ''} border-slate-300 text-center ${cellClass}">${h > 0 ? h.toFixed(1) : '0'}</td>`;
        });

        rowHtml += `</tr>`;
        html += rowHtml;
      });

      html += `</tbody></table></div></div>`;
    }

    html += `</div>`;
    content.innerHTML = html;
    container.classList.remove('hidden');
  }

  function renderTimeByWeekReport(data) {
    const container = document.getElementById('reportContainer');
    const content = document.getElementById('reportContent');
    if (!data || Object.keys(data.decks).length === 0) {
      content.innerHTML = '<div class="text-center text-slate-500 py-8 font-medium bg-slate-50 rounded-lg"><i class="fa-solid fa-folder-open text-3xl mb-3 block"></i>Brak zarejestrowanych prac w systemie.</div>';
      container.classList.remove('hidden');
      return;
    }
    let allWeeksSorted = data.allWeeks.sort((a, b) => a - b);
    let html = `<div class="bg-white p-3 border border-slate-300 mb-8 w-max min-w-[320px]"><p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-2 border-b border-slate-100 pb-1">Szczegóły raportu</p><div class="grid grid-cols-2 gap-x-6 gap-y-1 text-xs"><span class="font-bold text-slate-700">Project name:</span> <span class="text-right text-seaviaBlue font-bold">REV OCEAN 19577</span><span class="font-bold text-slate-700">Paid Breaks:</span> <span class="text-right ${data.settings.includeBreaks ? 'text-emerald-600' : 'text-slate-400'} font-bold">${data.settings.includeBreaks ? 'YES' : 'NO'}</span><span class="font-bold text-slate-700">Data generacji:</span> <span class="text-right font-mono">${new Date().toLocaleDateString('pl-PL')}</span></div></div><div class="flex flex-col gap-y-10" id="pdf-export-wrapper">`;

    Object.keys(data.decks).sort().forEach(deckName => {
      let deckData = data.decks[deckName] || {};
      html += `<div class="report-page w-full bg-white border border-slate-300 shadow-sm"><div class="bg-slate-100 p-2 border-b border-slate-300"><h3 class="font-black text-seaviaBlue text-[11px] uppercase tracking-wider">ANNUAL TIME REPORT - ${deckName}</h3></div><div class="overflow-x-auto"><table class="w-full text-left border-collapse text-[10px] sm:text-[11px]"><thead><tr class="bg-slate-50 text-slate-600"><th class="p-1 border-b border-r border-slate-300 text-center w-8">No.</th><th class="p-1 border-b border-r border-slate-300 min-w-[180px]">Tasks</th><th class="p-1 border-b border-r border-slate-300 text-center w-12 font-bold bg-slate-200">Total</th>${allWeeksSorted.map((week, i) => `<th class="p-1 border-b ${i < allWeeksSorted.length - 1 ? 'border-r' : ''} border-slate-300 text-center w-10">W${week}</th>`).join('')}</tr></thead><tbody>`;

      const renderRow = (taskName, index) => {
        let taskData = deckData.tasks[taskName] || { total: 0, weeklyHours: {} };
        let total = taskData.total;
        
        let rowHtml = `<tr class="border-b border-slate-200 hover:bg-blue-50/50"><td class="p-1 border-r border-slate-300 text-center text-slate-500 font-medium">${index}</td><td class="p-1 border-r border-slate-300 font-bold text-slate-700 leading-tight">${taskName}</td>`;
        let totalClass = total > 0 ? 'bg-green-200 text-green-900 font-black' : 'bg-slate-100 text-slate-400';
        rowHtml += `<td class="p-1 border-r border-slate-300 text-center ${totalClass}">${total > 0 ? total.toFixed(1) : '0'}</td>`;
        
        allWeeksSorted.forEach((weekNum, i) => {
          let h = taskData.weeklyHours[weekNum] || 0;
          let cellClass = h > 0 ? 'bg-green-100 text-green-800 font-black' : 'text-slate-300';
          rowHtml += `<td class="p-1 ${i < allWeeksSorted.length - 1 ? 'border-r' : ''} border-slate-300 text-center ${cellClass}">${h > 0 ? h.toFixed(1) : '0'}</td>`;
        });
        rowHtml += `</tr>`;
        return rowHtml;
      };

      // Supervision pojawia się na każdym pokładzie oprócz pokładu TRAVEL
      if (deckName !== "TRAVEL") {
        html += renderRow("Supervision", 0);
      }

      let filteredTasks = data.allTasks;
      if (!data.settings.includeBreaks) {
        filteredTasks = filteredTasks.filter(t => !t.toLowerCase().includes('break') && !t.toLowerCase().includes('przerwa'));
      }

      // Zadanie travel widoczne wyłącznie na pokładzie TRAVEL, na innych ukryte
      if (deckName === "TRAVEL") {
        filteredTasks = filteredTasks.filter(t => t.toLowerCase() === "travel");
      } else {
        filteredTasks = filteredTasks.filter(t => t.toLowerCase() !== "travel");
      }

      let taskIndex = 1;
      filteredTasks.forEach(taskName => {
        if(taskName !== "Supervision") {
          html += renderRow(taskName, taskIndex++);
        }
      });
      html += `</tbody></table></div></div>`;
    });

    // --- SEKCJA PRACE DODATKOWE (EXTRA JOBS) NA SAMYM DOLE ---
    if (data.extraTasks && data.extraTasks.length > 0) {
      html += `
      <div class="report-page w-full bg-white border border-slate-300 shadow-sm mt-10">
        <div class="bg-red-50 p-2 border-b border-slate-300">
            <h3 class="font-black text-red-700 text-[11px] uppercase tracking-wider">PRACE DODATKOWE (EXTRA JOBS)</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[10px] sm:text-[11px]">
                <thead>
                    <tr class="bg-slate-50 text-slate-600">
                        <th class="p-1 border-b border-r border-slate-300 text-center w-8">No.</th>
                        <th class="p-1 border-b border-r border-slate-300 min-w-[180px]">Tasks</th>
                        <th class="p-1 border-b border-r border-slate-300 text-center w-12 font-bold bg-slate-200">Total</th>
                        ${allWeeksSorted.map((week, i) => `<th class="p-1 border-b ${i < allWeeksSorted.length - 1 ? 'border-r' : ''} border-slate-300 text-center w-10">W${week}</th>`).join('')}
                    </tr>
                </thead>
                <tbody>
      `;

      let extraTaskIndex = 1;
      data.extraTasks.forEach(taskName => {
        let taskData = data.extraDeck.tasks[taskName] || { total: 0, weeklyHours: {} };
        let total = taskData.total;

        let rowHtml = `<tr class="border-b border-slate-200 hover:bg-red-50/30">
            <td class="p-1 border-r border-slate-300 text-center text-slate-500 font-medium">${extraTaskIndex++}</td>
            <td class="p-1 border-r border-slate-300 font-bold text-red-600 leading-tight">${taskName}</td>`;

        let totalClass = total > 0 ? 'bg-green-200 text-green-900 font-black' : 'bg-slate-100 text-slate-400';
        rowHtml += `<td class="p-1 border-r border-slate-300 text-center ${totalClass}">${total > 0 ? total.toFixed(1) : '0'}</td>`;

        allWeeksSorted.forEach((weekNum, i) => {
          let h = taskData.weeklyHours[weekNum] || 0;
          let cellClass = h > 0 ? 'bg-green-100 text-green-800 font-black' : 'text-slate-300';
          rowHtml += `<td class="p-1 ${i < allWeeksSorted.length - 1 ? 'border-r' : ''} border-slate-300 text-center ${cellClass}">${h > 0 ? h.toFixed(1) : '0'}</td>`;
        });

        rowHtml += `</tr>`;
        html += rowHtml;
      });

      html += `</tbody></table></div></div>`;
    }

    html += `</div>`;
    content.innerHTML = html;
    container.classList.remove('hidden');
  }

  function exportToPDF() {
    if (!currentReportData) return;
    if (typeof html2pdf === 'undefined') {
      alert("Trwa ładowanie biblioteki PDF. Spróbuj ponownie za chwilę.");
      return;
    }
    window.scrollTo(0, 0);
    setTimeout(() => {
      const element = document.getElementById('reportContent');
      const isWeekly = currentReportType === 'weekly';
      let pdfStyles = '';
      
      // Przełamywanie stron i unikanie podziałów tabel jest teraz aktywne w obu wersjach
      if (!isWeekly) {
        pdfStyles = `<style id="pdf-styles"> .report-page { page-break-after: always; page-break-inside: avoid; } .report-page:last-child { page-break-after: auto; } .report-page table { font-size: 8px !important; } .report-page th, .report-page td { padding: 1px 2px !important; } </style>`;
      } else {
        pdfStyles = `<style id="pdf-styles"> .report-page { page-break-after: always; page-break-inside: avoid; } .report-page:last-child { page-break-after: auto; } </style>`;
      }
      
      document.head.insertAdjacentHTML('beforeend', pdfStyles);
      const weekNum = isWeekly ? currentReportData.weekInfo.weekNumber : 'Annual';
      const opt = { margin: 0.3, filename: `Candido_Report_${weekNum}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas:  { scale: 2, useCORS: true }, jsPDF: { unit: 'in', format: 'a4', orientation: isWeekly ? 'portrait' : 'landscape' } };
      
      html2pdf().set(opt).from(element).save().then(() => {
        const styleTag = document.getElementById('pdf-styles');
        if (styleTag) styleTag.remove();
      });
    }, 0);
  }

  // --- FUNKCJA: EKSPORT DO EXCEL PRZEZ BACKEND ---
  function exportToExcel() {
    if (!currentReportData) {
      alert("Najpierw wygeneruj raport.");
      return;
    }
    const btn = document.getElementById('btnExportExcel');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Generowanie...';
    btn.disabled = true;
    google.script.run
      .withSuccessHandler(response => {
        if (response && response.fileUrl) {
          window.open(response.fileUrl, '_blank');
        } else {
          alert("Wystąpił błąd po stronie serwera, ale nie otrzymano linku do pliku.");
        }
        btn.innerHTML = '<i class="fa-solid fa-file-excel mr-2"></i> Pobierz XLSX';
        btn.disabled = false;
      })
      .withFailureHandler(err => {
        alert("Błąd generowania pliku: " + err.message);
        btn.innerHTML = '<i class="fa-solid fa-file-excel mr-2"></i> Pobierz XLSX';
        btn.disabled = false;
      })
      .generateStyledExcelReport(currentReportData, currentReportType);
  }
</script>